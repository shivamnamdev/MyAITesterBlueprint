# Mindset Builder Agent Environment Variables
# Port for the web portal (default: 5095)
PORT=5095

# Google Gemini API Key (optional - if omitted, built-in heuristic engine or Ollama will run)
GEMINI_API_KEY=

# Local Ollama Configuration (optional)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
